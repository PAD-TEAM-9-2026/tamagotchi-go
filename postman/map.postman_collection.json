{
  "info": {
    "name": "Map",
    "description": "Gateway-authenticated Map checks. Configure two real test users and matching bearer credentials. Location requests prepare only those users; probes are direct. See postman/README.md.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "function uuidv7() {",
          "  const ms = Date.now();",
          "  const bytes = new Uint8Array(16);",
          "  for (let i = 0; i < 6; i++) bytes[i] = Math.floor(ms / 2 ** (8 * (5 - i))) & 255;",
          "  for (let i = 6; i < 16; i++) bytes[i] = Math.floor(Math.random() * 256);",
          "  bytes[6] = (bytes[6] & 15) | 112;",
          "  bytes[8] = (bytes[8] & 63) | 128;",
          "  const hex = Array.from(bytes, b => b.toString(16).padStart(2, '0')).join('');",
          "  return [hex.slice(0, 8), hex.slice(8, 12), hex.slice(12, 16), hex.slice(16, 20), hex.slice(20)].join('-');",
          "}",
          "pm.variables.set('command_key', uuidv7());",
          "pm.variables.set('map_timestamp', new Date().toISOString());",
          "if (!['Health', 'Readiness', 'Missing authentication', 'Direct impersonation'].includes(pm.info.requestName) && !pm.environment.get('map_credential')) throw new Error('Configure the real test user credential before running domain requests.');"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Probes",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{map_probe_url}}/health",
              "host": [
                "{{map_probe_url}}"
              ],
              "path": [
                "health"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"service is up\", () => { pm.expect(pm.response.json().status).to.eql('UP') });"
                ]
              }
            }
          ]
        },
        {
          "name": "Readiness",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{map_probe_url}}/ready",
              "host": [
                "{{map_probe_url}}"
              ],
              "path": [
                "ready"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"database is ready\", () => { pm.expect(pm.response.json().status).to.eql('READY') });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Locations",
      "item": [
        {
          "name": "Create or update location",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{command_key}}"
              }
            ],
            "url": {
              "raw": "{{map_base_url}}/v1/location",
              "host": [
                "{{map_base_url}}"
              ],
              "path": [
                "v1",
                "location"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"user_id\":\"{{map_user_id}}\",\"lat\":47.0105,\"lng\":28.8638,\"timestamp\":\"{{map_timestamp}}\",\"accuracy_m\":5}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"accepted\", () => { pm.expect(pm.response.json().accepted).to.eql(true) });"
                ]
              }
            }
          ]
        },
        {
          "name": "Read location",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{map_base_url}}/v1/location/{{map_user_id}}",
              "host": [
                "{{map_base_url}}"
              ],
              "path": [
                "v1",
                "location",
                "{{map_user_id}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"matching user\", () => { pm.expect(pm.response.json().user_id).to.eql(pm.variables.get('map_user_id')) });"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const user = pm.environment.get('map_user_id');",
                  "const token = pm.environment.get('map_credential');",
                  "if (!user || !token) throw new Error('Configure map_user_id and map_credential.');",
                  "const body = {user_id: user, lat: 47.0105, lng: 28.8638, timestamp: pm.variables.get('map_timestamp'), accuracy_m: 5};",
                  "pm.sendRequest({url: pm.environment.get('map_base_url') + '/v1/location', method: 'POST', header: {'Content-Type': 'application/json', Authorization: 'Bearer ' + token, 'Idempotency-Key': pm.variables.get('command_key') + '-setup'}, body: {mode: 'raw', raw: JSON.stringify(body)}}, (error, response) => {",
                  "  if (error || response.code !== 200) throw new Error('Authenticated Map setup failed.');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Read nearby locations",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{map_base_url}}/v1/location/nearby/{{map_user_id}}?limit=10",
              "host": [
                "{{map_base_url}}"
              ],
              "path": [
                "v1",
                "location",
                "nearby",
                "{{map_user_id}}"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"nearby list\", () => { pm.expect(pm.response.json().nearby).to.be.an('array') });",
                  "pm.test('nearby stranger is visible', () => pm.expect(pm.response.json().nearby.map(x => x.user_id)).to.include(pm.variables.get('map_neighbor_id')));"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const user = pm.environment.get('map_user_id');",
                  "const neighbor = pm.environment.get('map_neighbor_id');",
                  "const token = pm.environment.get('map_credential');",
                  "const neighborToken = pm.environment.get('map_neighbor_credential');",
                  "if (!user || !neighbor || user === neighbor || !token || !neighborToken) throw new Error('Configure two distinct real Map test users and matching credentials.');",
                  "const send = (id, bearer, lat, suffix, next) => pm.sendRequest({url: pm.environment.get('map_base_url') + '/v1/location', method: 'POST', header: {'Content-Type': 'application/json', Authorization: 'Bearer ' + bearer, 'Idempotency-Key': pm.variables.get('command_key') + suffix}, body: {mode: 'raw', raw: JSON.stringify({user_id: id, lat, lng: 28.8638, timestamp: pm.variables.get('map_timestamp'), accuracy_m: 5})}}, (error, response) => {",
                  "  if (error || response.code !== 200) throw new Error('Authenticated nearby setup failed.');",
                  "  next();",
                  "});",
                  "send(user, token, 47.0105, '-viewer', () => send(neighbor, neighborToken, 47.01051, '-neighbor', () => {}));"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete location",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{map_base_url}}/v1/location/{{map_user_id}}",
              "host": [
                "{{map_base_url}}"
              ],
              "path": [
                "v1",
                "location",
                "{{map_user_id}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 204\", () => pm.response.to.have.status(204));"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const user = pm.environment.get('map_user_id');",
                  "const token = pm.environment.get('map_credential');",
                  "if (!user || !token) throw new Error('Configure map_user_id and map_credential.');",
                  "const body = {user_id: user, lat: 47.0105, lng: 28.8638, timestamp: pm.variables.get('map_timestamp'), accuracy_m: 5};",
                  "pm.sendRequest({url: pm.environment.get('map_base_url') + '/v1/location', method: 'POST', header: {'Content-Type': 'application/json', Authorization: 'Bearer ' + token, 'Idempotency-Key': pm.variables.get('command_key') + '-setup'}, body: {mode: 'raw', raw: JSON.stringify(body)}}, (error, response) => {",
                  "  if (error || response.code !== 200) throw new Error('Authenticated Map setup failed.');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Replay location command",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{command_key}}"
              }
            ],
            "url": {
              "raw": "{{map_base_url}}/v1/location",
              "host": [
                "{{map_base_url}}"
              ],
              "path": [
                "v1",
                "location"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"user_id\":\"{{map_user_id}}\",\"lat\":47.0105,\"lng\":28.8638,\"timestamp\":\"{{map_timestamp}}\",\"accuracy_m\":5}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.variables.replaceIn(pm.request.body.raw);",
                  "pm.sendRequest({url: pm.environment.get('map_base_url') + '/v1/location', method: 'POST', header: {'Content-Type': 'application/json', Authorization: 'Bearer ' + pm.environment.get('map_credential'), 'Idempotency-Key': pm.variables.get('command_key')}, body: {mode: 'raw', raw: body}}, (error, response) => {",
                  "  if (error || response.code !== 200) throw new Error('Replay setup failed.');",
                  "  pm.variables.set('recorded_receipt', response.text());",
                  "});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('identical receipt', () => pm.expect(pm.response.text()).to.eql(pm.variables.get('recorded_receipt')));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Refusals",
      "item": [
        {
          "name": "Invalid user ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{map_base_url}}/v1/location/not-a-uuid",
              "host": [
                "{{map_base_url}}"
              ],
              "path": [
                "v1",
                "location",
                "not-a-uuid"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 400\", () => pm.response.to.have.status(400));",
                  "pm.test(\"problem code\", () => { pm.expect(pm.response.json().code).to.eql('invalid_user_id') });"
                ]
              }
            }
          ]
        },
        {
          "name": "Unknown location",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{map_base_url}}/v1/location/{{map_user_id}}",
              "host": [
                "{{map_base_url}}"
              ],
              "path": [
                "v1",
                "location",
                "{{map_user_id}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 404\", () => pm.response.to.have.status(404));",
                  "pm.test(\"problem code\", () => { pm.expect(pm.response.json().code).to.eql('location_not_found') });"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.sendRequest({url: pm.environment.get('map_base_url') + '/v1/location/' + pm.environment.get('map_user_id'), method: 'DELETE', header: {Authorization: 'Bearer ' + pm.environment.get('map_credential')}}, (error, response) => {",
                  "  if (error || ![204, 404].includes(response.code)) throw new Error('Location absence setup failed.');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Invalid latitude",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{command_key}}"
              }
            ],
            "url": {
              "raw": "{{map_base_url}}/v1/location",
              "host": [
                "{{map_base_url}}"
              ],
              "path": [
                "v1",
                "location"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"user_id\":\"{{map_user_id}}\",\"lat\":91,\"lng\":28.8638,\"timestamp\":\"{{map_timestamp}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 400\", () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "Missing command key",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{map_base_url}}/v1/location",
              "host": [
                "{{map_base_url}}"
              ],
              "path": [
                "v1",
                "location"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"user_id\":\"{{map_user_id}}\",\"lat\":47.0105,\"lng\":28.8638,\"timestamp\":\"{{map_timestamp}}\",\"accuracy_m\":5}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 400', () => pm.response.to.have.status(400));",
                  "pm.test('key required', () => pm.expect(pm.response.json().code).to.eql('invalid_idempotency_key'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Missing authentication",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{map_base_url}}/v1/location/{{map_user_id}}",
              "host": [
                "{{map_base_url}}"
              ],
              "path": [
                "v1",
                "location",
                "{{map_user_id}}"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 401', () => pm.response.to.have.status(401));",
                  "pm.test('problem code', () => pm.expect(pm.response.json().code).to.eql('unauthorized'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Forged plain identity",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-User-Id",
                "value": "{{map_neighbor_id}}"
              }
            ],
            "url": {
              "raw": "{{map_base_url}}/v1/location/{{map_neighbor_id}}",
              "host": [
                "{{map_base_url}}"
              ],
              "path": [
                "v1",
                "location",
                "{{map_neighbor_id}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 403', () => pm.response.to.have.status(403));",
                  "pm.test('problem code', () => pm.expect(pm.response.json().code).to.eql('not_self'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Direct impersonation",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-User-Id",
                "value": "{{map_user_id}}"
              }
            ],
            "url": {
              "raw": "{{map_probe_url}}/v1/location/{{map_user_id}}",
              "host": [
                "{{map_probe_url}}"
              ],
              "path": [
                "v1",
                "location",
                "{{map_user_id}}"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 401', () => pm.response.to.have.status(401));",
                  "pm.test('problem code', () => pm.expect(pm.response.json().code).to.eql('invalid_gateway_assertion'));"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{map_credential}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "command_key",
      "value": ""
    }
  ]
}
