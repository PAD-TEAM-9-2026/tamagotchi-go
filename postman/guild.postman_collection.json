{
  "info": {
    "name": "Guild",
    "description": "Every endpoint of the Guild service, in an order that runs start to finish against an empty or populated database. Requests capture ids into collection variables, so a full run needs no manual input beyond the Tamagotchi Go Local environment.\n\nUUID v7 is generated in the collection pre-request script, matching the contract's UUID v7 requirement.\n\nThe guild chat endpoint is a WebSocket and is not exercised here; see the service README.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "guild_id",
      "value": ""
    },
    {
      "key": "guild_version",
      "value": ""
    },
    {
      "key": "leader_id",
      "value": ""
    },
    {
      "key": "officer_to_be_id",
      "value": ""
    },
    {
      "key": "decliner_id",
      "value": ""
    },
    {
      "key": "revokee_id",
      "value": ""
    },
    {
      "key": "kicked_id",
      "value": ""
    },
    {
      "key": "outsider_id",
      "value": ""
    },
    {
      "key": "idempotency_key",
      "value": ""
    },
    {
      "key": "run_suffix",
      "value": ""
