  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "function uuidv7() {",
          "  const ms = Date.now();",
          "  const bytes = new Uint8Array(16);",
          "  bytes[0] = Math.floor(ms / 1099511627776) & 0xff;",
          "  bytes[1] = Math.floor(ms / 4294967296) & 0xff;",
          "  bytes[2] = Math.floor(ms / 16777216) & 0xff;",
          "  bytes[3] = Math.floor(ms / 65536) & 0xff;",
          "  bytes[4] = Math.floor(ms / 256) & 0xff;",
          "  bytes[5] = ms & 0xff;",
          "  for (let i = 6; i < 16; i += 1) {",
          "    bytes[i] = Math.floor(Math.random() * 256);",
          "  }",
          "  bytes[6] = (bytes[6] & 0x0f) | 0x70;",
          "  bytes[8] = (bytes[8] & 0x3f) | 0x80;",
          "  const hex = Array.from(bytes, (b) => b.toString(16).padStart(2, '0')).join('');",
          "  return [hex.slice(0, 8), hex.slice(8, 12), hex.slice(12, 16), hex.slice(16, 20), hex.slice(20)].join('-');",
          "}",
          "",
          "function seed(key, value) {",
          "  if (!pm.collectionVariables.get(key)) {",
          "    pm.collectionVariables.set(key, value);",
          "  }",
          "}",
          "",
          "pm.collectionVariables.set('idempotency_key', uuidv7());",
          "",
          "seed('leader_id', uuidv7());",
          "seed('officer_to_be_id', uuidv7());",
          "seed('decliner_id', uuidv7());",
          "seed('revokee_id', uuidv7());",
          "seed('kicked_id', uuidv7());",
          "seed('outsider_id', uuidv7());",
          "seed('run_suffix', Date.now().toString());",
          ""
        ]
      }
    }
  ],
