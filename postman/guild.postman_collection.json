                "guilds"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 unauthorized', () => {",
                  "  pm.response.to.have.status(401);",
                  "  pm.expect(pm.response.json().code).to.eql('unauthorized');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Missing Idempotency-Key on a command",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-User-Id",
                "value": "{{outsider_id}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{guild_base_url}}/v1/guilds",
              "host": [
                "{{guild_base_url}}"
              ],
              "path": [
                "v1",
                "guilds"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"No key guild\",\n  \"description\": \"\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 idempotency_key_required', () => {",
                  "  pm.response.to.have.status(400);",
                  "  pm.expect(pm.response.json().code).to.eql('idempotency_key_required');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "An unknown guild",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-User-Id",
                "value": "{{outsider_id}}"
              }
            ],
            "url": {
              "raw": "{{guild_base_url}}/v1/guilds/00000000-0000-7000-8000-000000000000",
              "host": [
                "{{guild_base_url}}"
              ],
              "path": [
                "v1",
                "guilds",
                "00000000-0000-7000-8000-000000000000"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('404 guild_not_found', () => {",
                  "  pm.response.to.have.status(404);",
                  "  pm.expect(pm.response.json().code).to.eql('guild_not_found');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "An outsider cannot invite",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-User-Id",
                "value": "{{outsider_id}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idempotency_key}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{guild_base_url}}/v1/guilds/{{guild_id}}/invitations",
              "host": [
                "{{guild_base_url}}"
              ],
              "path": [
                "v1",
                "guilds",
                "{{guild_id}}",
                "invitations"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"invited_user_id\": \"{{outsider_id}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('403, not a member of this guild', () => pm.response.to.have.status(403));"
                ]
