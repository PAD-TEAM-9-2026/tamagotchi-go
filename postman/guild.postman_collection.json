        {
          "name": "An officer cannot delete the guild",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "X-User-Id",
                "value": "{{leader_id}}"
              }
            ],
            "url": {
              "raw": "{{guild_base_url}}/v1/guilds/{{guild_id}}",
              "host": [
                "{{guild_base_url}}"
              ],
              "path": [
                "v1",
                "guilds",
                "{{guild_id}}"
              ]
            },
            "description": "leader_id was demoted to OFFICER by the leadership transfer above, so this checks that officers still cannot delete the guild."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('403, only the leader may delete', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        }
