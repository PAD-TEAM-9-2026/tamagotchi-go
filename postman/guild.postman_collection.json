            "url": {
              "raw": "{{guild_base_url}}/v1/guilds/{{guild_id}}/members/{{kicked_id}}",
              "host": [
                "{{guild_base_url}}"
              ],
              "path": [
                "v1",
                "guilds",
                "{{guild_id}}",
                "members",
                "{{kicked_id}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('204, officers may remove plain members', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "Transfer leadership to the officer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-User-Id",
                "value": "{{leader_id}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idempotency_key}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{guild_base_url}}/v1/guilds/{{guild_id}}/leadership",
              "host": [
                "{{guild_base_url}}"
              ],
              "path": [
                "v1",
                "guilds",
                "{{guild_id}}",
                "leadership"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": \"{{officer_to_be_id}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200, leadership moved', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().leader_id).to.eql(pm.collectionVariables.get('officer_to_be_id'));",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Chat history",
      "item": [
        {
          "name": "Read the chat history",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-User-Id",
                "value": "{{officer_to_be_id}}"
              }
            ],
            "url": {
              "raw": "{{guild_base_url}}/v1/guilds/{{guild_id}}/messages",
              "host": [
                "{{guild_base_url}}"
              ],
              "path": [
                "v1",
                "guilds",
                "{{guild_id}}",
                "messages"
              ]
            },
            "description": "Chat itself is a WebSocket (GET /v1/guilds/{guildId}/chat, upgraded), which a plain HTTP collection cannot exercise. See the service README for a wscat example."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200, page shape even with no messages', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.property('items');",
                  "  pm.expect(body).to.have.property('next_cursor');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Refusals",
      "item": [
        {
          "name": "No credentials at all",
          "request": {
            "method": "GET",
            "header": [],
