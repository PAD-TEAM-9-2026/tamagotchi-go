          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 created, leader is the only member', () => {",
                  "  pm.response.to.have.status(201);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.leader_id).to.eql(pm.collectionVariables.get('leader_id'));",
                  "  pm.expect(body.member_count).to.eql(1);",
                  "  pm.expect(body.version).to.eql(1);",
                  "  pm.collectionVariables.set('guild_id', body.guild_id);",
                  "});"
