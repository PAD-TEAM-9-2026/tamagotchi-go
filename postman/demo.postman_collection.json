    {
      "name": "Map nested-call log demo",
      "description": "Run these two requests in order. First refreshes only the dedicated viewer location. Nearby reads relationships through a second Gateway call. Both services and Gateway log correlation IDs.",
      "item": [
        {
          "name": "Refresh viewer location",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{demo_command_key}}"
              }
            ],
            "url": "{{map_base_url}}/v1/location",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": \"{{demo_user_id}}\",\n  \"lat\": 47.0105,\n  \"lng\": 28.8638,\n  \"timestamp\": \"{{demo_now}}\",\n  \"accuracy_m\": 5\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 response', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Nearby players and nested relationship call",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{map_base_url}}/v1/location/nearby/{{demo_user_id}}?limit=10"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 response', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Friend request to Notification",
      "description": "Use two fresh unrelated registered users; demo_other_credential is sender, demo_credential/demo_user_id recipient. Run both requests in order. This proves persisted history, not device push. Repeating requires fresh actors or a cleared terminal relationship request.",
      "item": [
        {
          "name": "Send a real friend request",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{demo_command_key}}"
              }
            ],
            "url": "{{user_management_base_url}}/v1/friend-requests",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{demo_other_credential}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"to_user_id\": \"{{demo_user_id}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 friend request',()=>pm.response.to.have.status(201));",
                  "if(pm.response.code===201)pm.collectionVariables.set('demo_friend_request_id',pm.response.json().request_id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Wait for recipient notification",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{notification_base_url}}/v1/users/{{demo_user_id}}/notifications?limit=100"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 history',()=>pm.response.to.have.status(200));",
                  "const wanted=pm.collectionVariables.get('demo_friend_request_id'); if(!wanted)throw new Error('Run the producer request in this scenario first');",
                  "const end=Date.now()+15000; const url=pm.variables.replaceIn('{{notification_base_url}}/v1/users/{{demo_user_id}}/notifications?limit=100');",
                  "function inspect(response){const rows=response.json().items;return rows.find(n=>n.type==='FRIEND_REQUEST' && JSON.stringify(n.params).includes(wanted));}",
                  "function wait(response){if(response.code!==200){pm.test('history poll succeeds',()=>pm.expect(response.code).to.eql(200));return;}const n=inspect(response);if(n){pm.test('real event persisted for recipient',()=>pm.expect(n.type).to.eql('FRIEND_REQUEST'));pm.collectionVariables.set('demo_notification_id',n.id);return;}if(Date.now()>=end){pm.test('notification arrives within 15 seconds',()=>pm.expect.fail('Event did not reach recipient history'));return;}setTimeout(()=>pm.sendRequest({url,method:'GET',header:{Authorization:'Bearer '+pm.variables.get('demo_credential')}},(err,r)=>{if(err){pm.test('history poll transport',()=>pm.expect.fail(String(err)));return;}wait(r);}),500);}",
                  "wait(pm.response);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Guild socket negotiation",
      "description": "Run independently with a real demo_guild_id containing the authenticated user. The returned URL/ticket is for a direct Guild socket. In a Postman WebSocket tab send the auth frame within five seconds. Tickets are single-use and last 30 seconds.",
      "item": [
        {
          "name": "Negotiate direct Guild socket",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{demo_command_key}}"
              }
            ],
            "url": "{{gateway_base_url}}/gateway/v1/ws-negotiate",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"resource\": \"guild.chat\",\n  \"resource_id\": \"{{demo_guild_id}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 response', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
