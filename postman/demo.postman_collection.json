{
  "info": {
    "name": "Tamagotchi Go Demo",
    "description": "Manual demo and independent checks through the real Gateway. Supply matching dedicated user IDs/bearers; stateful scenarios declare their own setup. Use canonical collections for full regression. Credentials stay in the local environment. Socket auth frame: {\"type\":\"auth\",\"ticket\":\"<returned ticket>\"}.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{demo_credential}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "function uuidv7() { const b = new Uint8Array(16); let t = Date.now(); for(let i=5;i>=0;i--){b[i]=t%256;t=Math.floor(t/256);} for(let i=6;i<16;i++)b[i]=Math.floor(Math.random()*256); b[6]=(b[6]&15)|112;b[8]=(b[8]&63)|128;const h=Array.from(b,x=>x.toString(16).padStart(2,'0')).join('');return [h.slice(0,8),h.slice(8,12),h.slice(12,16),h.slice(16,20),h.slice(20)].join('-');}",
          "const cid=uuidv7();pm.variables.set('demo_correlation_id',cid);pm.variables.set('demo_command_key',uuidv7());pm.variables.set('demo_now',new Date().toISOString());pm.request.headers.upsert({key:'X-Correlation-Id',value:cid});console.log('Request correlation:',cid);"
        ]
      }
    }
  ],
