                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test(\"HTTP 202\", () => pm.response.to.have.status(202));"
                    ]
                  }
                }
              ]
            },
            {
              "name": "Deregister disposable instance",
