        {
          "name": "Disposable registration lifecycle",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const base = pm.variables.get(\"discovery_url\");",
                  "if (pm.environment.get(\"management_fixture_writes\") !== \"true\" ||",
                  "    !/^http:\\/\\/(?:localhost|127\\.0\\.0\\.1|\\[::1\\]):[0-9]+$/.test(base)) {",
                  "  pm.execution.skipRequest();",
                  "}"
                ]
              }
            }
          ],
          "item": [
            {
              "name": "Register disposable instance",
              "request": {
                "method": "POST",
                "url": "{{discovery_url}}/v1/instances",
                "auth": {
                  "type": "noauth"
                },
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"instance_id\": \"{{discovery_fixture_id}}\",\n  \"service_name\": \"postman-fixture\",\n  \"host\": \"service-discovery\",\n  \"port\": 3009,\n  \"status_path\": \"/status\",\n  \"version\": \"1.0.0\"\n}"
                }
