          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{monster_raid_base_url}}/v1/raids",
              "host": [
                "{{monster_raid_base_url}}"
              ],
              "path": [
                "v1",
                "raids"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 401\", () => pm.response.to.have.status(401));",
                  "pm.test(\"problem code\", () => { pm.expect(pm.response.json().code).to.eql('mock_identity_required') });"
                ]
              }
            }
          ]
        },
        {
          "name": "Unknown raid",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-User-Id",
                "value": "{{raid_leader_id}}"
              }
            ],
            "url": {
              "raw": "{{monster_raid_base_url}}/v1/raids/{{raid_id}}",
              "host": [
                "{{monster_raid_base_url}}"
              ],
              "path": [
                "v1",
                "raids",
                "{{raid_id}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 404\", () => pm.response.to.have.status(404));",
                  "pm.test(\"problem code\", () => { pm.expect(pm.response.json().code).to.eql('raid_not_found') });"
                ]
              }
            }
          ]
        },
        {
          "name": "Attack actor mismatch",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-User-Id",
                "value": "{{raid_leader_id}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{monster_raid_base_url}}/v1/raids/{{raid_id}}/attack",
              "host": [
                "{{monster_raid_base_url}}"
              ],
              "path": [
                "v1",
                "raids",
                "{{raid_id}}",
                "attack"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"user_id\":\"{{raid_guild_id}}\"}",
              "options": {
