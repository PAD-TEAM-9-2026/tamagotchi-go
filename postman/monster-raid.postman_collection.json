{
  "info": {
    "name": "Monster Raid",
    "description": "Run the domain flow in order through Gateway. Configure a real Guild leader, unused active Registry occurrence and available primary creature. No mock fixture identities or occurrences. See postman/README.md.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "function uuidv7() {",
          "  const ms = Date.now();",
          "  const bytes = new Uint8Array(16);",
          "  for (let i = 0; i < 6; i++) bytes[i] = Math.floor(ms / 2 ** (8 * (5 - i))) & 255;",
          "  for (let i = 6; i < 16; i++) bytes[i] = Math.floor(Math.random() * 256);",
          "  bytes[6] = (bytes[6] & 15) | 112;",
          "  bytes[8] = (bytes[8] & 63) | 128;",
          "  const hex = Array.from(bytes, b => b.toString(16).padStart(2, '0')).join('');",
          "  return [hex.slice(0, 8), hex.slice(8, 12), hex.slice(12, 16), hex.slice(16, 20), hex.slice(20)].join('-');",
          "}",
          "pm.variables.set('command_key', uuidv7());",
          "pm.variables.set('unknown_raid_id', uuidv7());",
          "pm.variables.set('other_actor_id', uuidv7());",
          "if (!['Health', 'Readiness', 'Missing authentication', 'Direct impersonation'].includes(pm.info.requestName) && !pm.environment.get('raid_leader_credential')) throw new Error('Configure the real test user credential before running domain requests.');"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Probes",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{monster_raid_probe_url}}/health",
              "host": [
                "{{monster_raid_probe_url}}"
              ],
              "path": [
                "health"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"service is up\", () => { pm.expect(pm.response.json().status).to.eql('UP') });"
                ]
              }
            }
          ]
        },
        {
          "name": "Readiness",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{monster_raid_probe_url}}/ready",
              "host": [
                "{{monster_raid_probe_url}}"
              ],
              "path": [
                "ready"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"database is ready\", () => { pm.expect(pm.response.json().status).to.eql('READY') });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Raids",
      "item": [
        {
          "name": "Create raid",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{command_key}}"
              }
            ],
            "url": {
              "raw": "{{monster_raid_base_url}}/v1/raids",
              "host": [
                "{{monster_raid_base_url}}"
              ],
              "path": [
                "v1",
                "raids"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"guild_id\":\"{{raid_guild_id}}\",\"occurrence_id\":\"{{raid_occurrence_id}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "for (const key of ['raid_leader_id','raid_guild_id','raid_occurrence_id']) {",
                  "  if (!pm.environment.get(key)) throw new Error('Configure the real Raid test fixture: ' + key);",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) {",
                  "  const raid = pm.response.json();",
                  "  pm.environment.set('raid_id', raid.raid_id);",
                  "  pm.variables.set('raid_id', raid.raid_id);",
                  "  pm.environment.set('raid_hp_before_attack', raid.boss.current_hp);",
                  "  pm.test('raid is active', () => pm.expect(raid.status).to.eql('ACTIVE'));",
                  "}",
                  "if (pm.response.code === 201) pm.environment.set('raid_create_key', pm.variables.get('command_key'));",
                  "if (pm.response.code === 201) pm.environment.set('raid_create_receipt', pm.response.text());"
                ]
              }
            }
          ]
        },
        {
          "name": "Replay raid creation",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{raid_create_key}}"
              }
            ],
            "url": {
              "raw": "{{monster_raid_base_url}}/v1/raids",
              "host": [
                "{{monster_raid_base_url}}"
              ],
              "path": [
                "v1",
                "raids"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"guild_id\":\"{{raid_guild_id}}\",\"occurrence_id\":\"{{raid_occurrence_id}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "pm.test('identical creation receipt', () => pm.expect(pm.response.json()).to.deep.equal(JSON.parse(pm.environment.get('raid_create_receipt'))));"
                ]
              }
            }
          ]
        },
        {
          "name": "List raids",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{monster_raid_base_url}}/v1/raids?limit=10",
              "host": [
                "{{monster_raid_base_url}}"
              ],
              "path": [
                "v1",
                "raids"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"raid page\", () => { pm.expect(pm.response.json().items).to.be.an('array') });"
                ]
              }
            }
          ]
        },
        {
          "name": "Read raid",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{monster_raid_base_url}}/v1/raids/{{raid_id}}",
              "host": [
                "{{monster_raid_base_url}}"
              ],
              "path": [
                "v1",
                "raids",
                "{{raid_id}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"matching raid\", () => { pm.expect(pm.response.json().raid_id).to.eql(pm.variables.get('raid_id')) });"
                ]
              }
            }
          ]
        },
        {
          "name": "Attack raid",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{command_key}}"
              }
            ],
            "url": {
              "raw": "{{monster_raid_base_url}}/v1/raids/{{raid_id}}/attack",
              "host": [
                "{{monster_raid_base_url}}"
              ],
              "path": [
                "v1",
                "raids",
                "{{raid_id}}",
                "attack"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"user_id\":\"{{raid_leader_id}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) {",
                  "  const attack = pm.response.json();",
                  "  pm.test('matching attacker', () => pm.expect(attack.attacker_id).to.eql(pm.environment.get('raid_leader_id')));",
                  "  pm.test('positive integer damage', () => { pm.expect(Number.isInteger(attack.damage_dealt)).to.eql(true); pm.expect(attack.damage_dealt).to.be.at.least(1); });",
                  "  pm.test('credited HP delta', () => pm.expect(attack.boss_hp_remaining).to.eql(Number(pm.environment.get('raid_hp_before_attack')) - attack.damage_dealt));",
                  "  pm.test('fixture remains active for cancellation', () => pm.expect(attack.status).to.eql('ACTIVE'));",
                  "}",
                  "if (pm.response.code === 200) pm.environment.set('raid_attack_key', pm.variables.get('command_key'));",
                  "if (pm.response.code === 200) pm.environment.set('raid_attack_receipt', pm.response.text());"
                ]
              }
            }
          ]
        },
        {
          "name": "Replay raid attack",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{raid_attack_key}}"
              }
            ],
            "url": {
              "raw": "{{monster_raid_base_url}}/v1/raids/{{raid_id}}/attack",
              "host": [
                "{{monster_raid_base_url}}"
              ],
              "path": [
                "v1",
                "raids",
                "{{raid_id}}",
                "attack"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"user_id\":\"{{raid_leader_id}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('identical attack receipt', () => pm.expect(pm.response.json()).to.deep.equal(JSON.parse(pm.environment.get('raid_attack_receipt'))));"
                ]
              }
            }
          ]
        },
        {
          "name": "Read leaderboard",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{monster_raid_base_url}}/v1/raids/{{raid_id}}/leaderboard",
              "host": [
                "{{monster_raid_base_url}}"
              ],
              "path": [
                "v1",
                "raids",
                "{{raid_id}}",
                "leaderboard"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"leaderboard items\", () => { pm.expect(pm.response.json().items).to.be.an('array') });",
                  "pm.test('attacker appears in leaderboard', () => pm.expect(pm.response.json().items.map(x => x.user_id)).to.include(pm.variables.get('raid_leader_id')));"
                ]
              }
            }
          ]
        },
        {
          "name": "Cancel raid",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{monster_raid_base_url}}/v1/raids/{{raid_id}}",
              "host": [
                "{{monster_raid_base_url}}"
              ],
              "path": [
                "v1",
                "raids",
                "{{raid_id}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 204\", () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Refusals",
      "item": [
        {
          "name": "Missing authentication",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{monster_raid_base_url}}/v1/raids",
              "host": [
                "{{monster_raid_base_url}}"
              ],
              "path": [
                "v1",
                "raids"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 401', () => pm.response.to.have.status(401));",
                  "pm.test('anonymous caller refused', () => pm.expect(pm.response.json().code).to.eql('unauthorized'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Unknown raid",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{monster_raid_base_url}}/v1/raids/{{unknown_raid_id}}",
              "host": [
                "{{monster_raid_base_url}}"
              ],
              "path": [
                "v1",
                "raids",
                "{{unknown_raid_id}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 404\", () => pm.response.to.have.status(404));",
                  "pm.test(\"problem code\", () => { pm.expect(pm.response.json().code).to.eql('raid_not_found') });"
                ]
              }
            }
          ]
        },
        {
          "name": "Attack actor mismatch",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{command_key}}"
              }
            ],
            "url": {
              "raw": "{{monster_raid_base_url}}/v1/raids/{{raid_id}}/attack",
              "host": [
                "{{monster_raid_base_url}}"
              ],
              "path": [
                "v1",
                "raids",
                "{{raid_id}}",
                "attack"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"user_id\":\"{{other_actor_id}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 403\", () => pm.response.to.have.status(403));",
                  "pm.test(\"problem code\", () => { pm.expect(pm.response.json().code).to.eql('actor_mismatch') });"
                ]
              }
            }
          ]
        },
        {
          "name": "Direct impersonation",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-User-Id",
                "value": "{{raid_leader_id}}"
              }
            ],
            "url": {
              "raw": "{{monster_raid_probe_url}}/v1/raids",
              "host": [
                "{{monster_raid_probe_url}}"
              ],
              "path": [
                "v1",
                "raids"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 401', () => pm.response.to.have.status(401));",
                  "pm.test('problem code', () => pm.expect(pm.response.json().code).to.eql('invalid_gateway_assertion'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Missing command key",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{monster_raid_base_url}}/v1/raids",
              "host": [
                "{{monster_raid_base_url}}"
              ],
              "path": [
                "v1",
                "raids"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"guild_id\":\"{{raid_guild_id}}\",\"occurrence_id\":\"{{raid_occurrence_id}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 400', () => pm.response.to.have.status(400));",
                  "pm.test('key required', () => pm.expect(pm.response.json().code).to.eql('invalid_idempotency_key'));"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{raid_leader_credential}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "command_key",
      "value": ""
    }
  ]
}
