    {
      "name": "Battles",
      "item": [
        {
          "name": "Create the challenge",
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-User-Id", "value": "{{challenger_id}}" },
              { "key": "Idempotency-Key", "value": "{{idempotency_key}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{battle_base_url}}/v1/battles",
              "host": ["{{battle_base_url}}"],
              "path": ["v1", "battles"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"opponent_id\": \"{{opponent_id}}\",\n  \"primary_id\": \"{{challenger_primary_id}}\",\n  \"secondary_id\": \"{{challenger_secondary_id}}\",\n  \"boost_ids\": []\n}",
              "options": { "raw": { "language": "json" } }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 PENDING_ACCEPT, challenger side only', () => {",
                  "  pm.response.to.have.status(201);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.status).to.eql('PENDING_ACCEPT');",
                  "  pm.expect(body.challenger_id).to.eql(pm.collectionVariables.get('challenger_id'));",
                  "  pm.expect(body.opponent_id).to.eql(pm.collectionVariables.get('opponent_id'));",
                  "  pm.expect(body.sides).to.have.lengthOf(1);",
                  "  pm.expect(body.version).to.eql(1);",
                  "  pm.collectionVariables.set('battle_id', body.battle_id);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "List battles as the challenger",
          "request": {
            "method": "GET",
            "header": [{ "key": "X-User-Id", "value": "{{challenger_id}}" }],
            "url": {
              "raw": "{{battle_base_url}}/v1/battles?limit=10",
              "host": ["{{battle_base_url}}"],
              "path": ["v1", "battles"],
              "query": [{ "key": "limit", "value": "10" }]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200, the new challenge is in the page', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const ids = pm.response.json().items.map((b) => b.battle_id);",
                  "  pm.expect(ids).to.include(pm.collectionVariables.get('battle_id'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Read the battle as the challenger",
          "request": {
            "method": "GET",
            "header": [{ "key": "X-User-Id", "value": "{{challenger_id}}" }],
            "url": {
              "raw": "{{battle_base_url}}/v1/battles/{{battle_id}}",
              "host": ["{{battle_base_url}}"],
              "path": ["v1", "battles", "{{battle_id}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200, matches what was created', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().battle_id).to.eql(pm.collectionVariables.get('battle_id'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Read the battle as the opponent",
          "request": {
            "method": "GET",
            "header": [{ "key": "X-User-Id", "value": "{{opponent_id}}" }],
            "url": {
              "raw": "{{battle_base_url}}/v1/battles/{{battle_id}}",
              "host": ["{{battle_base_url}}"],
              "path": ["v1", "battles", "{{battle_id}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200, the opponent is a participant too', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Accept the challenge",
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-User-Id", "value": "{{opponent_id}}" },
              { "key": "Idempotency-Key", "value": "{{idempotency_key}}" },
              { "key": "Content-Type", "value": "application/json" }
