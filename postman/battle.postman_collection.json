            "url": {
              "raw": "{{battle_base_url}}/v1/battles/{{battle_id}}/accept",
              "host": ["{{battle_base_url}}"],
              "path": ["v1", "battles", "{{battle_id}}", "accept"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"primary_id\": \"{{opponent_primary_id}}\",\n  \"secondary_id\": \"{{opponent_secondary_id}}\",\n  \"boost_ids\": []\n}",
              "options": { "raw": { "language": "json" } }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('202 ONGOING, both sides now present', () => {",
                  "  pm.response.to.have.status(202);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.status).to.eql('ONGOING');",
                  "  pm.expect(body.sides).to.have.lengthOf(2);",
                  "  pm.expect(body.version).to.eql(2);",
                  "});"
                ]
              }
            }
          ]
        },
