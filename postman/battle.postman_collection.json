              "path": ["v1", "battles", "{{battle_id}}", "forfeit"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 COMPLETED, the forfeiter loses', () => {",
