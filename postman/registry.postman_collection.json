{
  "info": {
    "name": "Package Registry",
    "description": "Every endpoint of the Package Registry service, in an order that runs start to finish against an empty or populated database.\n\nAdmin endpoints (creating packages, bosses, raid occurrences) need a user id configured in the service's ADMIN_USER_IDS. This collection's `admin_id` variable is fixed (not randomly generated) so you can add it once: set ADMIN_USER_IDS=00000000-0000-4000-8000-00000000a11e in the service's .env and restart it before running this collection.\n\nUUID v7 is generated in the collection pre-request script, matching the contract's UUID v7 requirement.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3001"
    },
    {
      "key": "admin_id",
      "value": "00000000-0000-4000-8000-00000000a11e"
    },
    {
      "key": "package_id",
      "value": ""
    },
    {
      "key": "package_revision",
      "value": ""
    },
    {
      "key": "boss_id",
      "value": ""
    },
    {
      "key": "boss_version",
      "value": ""
    },
    {
      "key": "occurrence_id",
      "value": ""
    },
    {
      "key": "developer_id",
      "value": ""
    },
    {
      "key": "moderator_id",
      "value": ""
    },
    {
      "key": "outsider_id",
      "value": ""
    },
    {
      "key": "idempotency_key",
      "value": ""
    },
    {
      "key": "run_suffix",
      "value": ""
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "function uuidv7() {",
          "  const ms = Date.now();",
          "  const bytes = new Uint8Array(16);",
          "  bytes[0] = Math.floor(ms / 1099511627776) & 0xff;",
          "  bytes[1] = Math.floor(ms / 4294967296) & 0xff;",
          "  bytes[2] = Math.floor(ms / 16777216) & 0xff;",
          "  bytes[3] = Math.floor(ms / 65536) & 0xff;",
          "  bytes[4] = Math.floor(ms / 256) & 0xff;",
          "  bytes[5] = ms & 0xff;",
          "  for (let i = 6; i < 16; i += 1) {",
          "    bytes[i] = Math.floor(Math.random() * 256);",
          "  }",
          "  bytes[6] = (bytes[6] & 0x0f) | 0x70;",
          "  bytes[8] = (bytes[8] & 0x3f) | 0x80;",
          "  const hex = Array.from(bytes, (b) => b.toString(16).padStart(2, '0')).join('');",
          "  return [hex.slice(0, 8), hex.slice(8, 12), hex.slice(12, 16), hex.slice(16, 20), hex.slice(20)].join('-');",
          "}",
          "",
          "function seed(key, value) {",
          "  if (!pm.collectionVariables.get(key)) {",
          "    pm.collectionVariables.set(key, value);",
          "  }",
          "}",
          "",
          "pm.collectionVariables.set('idempotency_key', uuidv7());",
          "",
          "seed('developer_id', uuidv7());",
          "seed('moderator_id', uuidv7());",
          "seed('outsider_id', uuidv7());",
          "seed('run_suffix', Date.now().toString());",
          ""
        ]
      }
    }
  ],
