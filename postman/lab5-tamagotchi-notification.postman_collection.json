    {
      "name": "Notification cache",
      "description": "Run in order. Saving the preferences deletes their key after the commit, so the next read is MISS and the one after it HIT. History caches only the first page, for 30 s.",
      "item": [
        {
          "name": "Preferences, first read",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('X-Cache is MISS or HIT', () => {",
                  "  pm.expect([\"MISS\", \"HIT\"]).to.include(pm.response.headers.get('X-Cache'));",
                  "});",
                  "pm.collectionVariables.set('cache_preferences_etag', pm.response.headers.get('ETag'));",
                  "pm.collectionVariables.set('cache_muted', JSON.stringify(pm.response.json().muted_categories));"
