    {
      "name": "2PC abort: a NO vote",
      "description": "Send, then settle a battle in 2PC mode. Tamagotchi votes NO with reason fault_injected, the coordinator aborts, and Battle's next attempt (.1) commits. Faults live in the database, so both replicas share them.",
      "item": [
        {
          "name": "Arm: Tamagotchi votes NO on the next prepare",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('armed as asked', () => pm.expect(body).to.eql({\"operation\": \"tamagotchi.tx_prepare\", \"mode\": \"vote_no\", \"delay_ms\": 0, \"remaining\": 1}));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_credential}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
