{
  "info": {
    "name": "Lab 5 Tamagotchi and Notification",
    "description": "Cache and fault-switch checks for Tamagotchi and Notification on the ./up.sh lab5 stack. Cache requests go through the Gateway as demo_user_id, who must hold a creature. Fault requests call Tamagotchi's replicas directly on the demo overlay's loopback ports with admin_credential, a User Management token with the admin role.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Tamagotchi cache",
      "description": "Run in order. A first read may be MISS or HIT; the next read of the same key within its TTL (type matrix 3600 s, collection first page 60 s, creature 300 s) must be HIT. Pages with limit or cursor are never cached.",
      "item": [
        {
          "name": "Type matrix, first read",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('X-Cache is MISS or HIT', () => {",
                  "  pm.expect([\"MISS\", \"HIT\"]).to.include(pm.response.headers.get('X-Cache'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{tamagotchi_base_url}}/v1/types/matrix",
              "host": [
                "{{tamagotchi_base_url}}"
              ],
              "path": [
                "v1",
                "types",
                "matrix"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Type matrix again is a HIT",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('X-Cache is HIT', () => {",
                  "  pm.expect([\"HIT\"]).to.include(pm.response.headers.get('X-Cache'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{tamagotchi_base_url}}/v1/types/matrix",
              "host": [
                "{{tamagotchi_base_url}}"
              ],
              "path": [
                "v1",
                "types",
                "matrix"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Collection, first page",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('X-Cache is MISS or HIT', () => {",
                  "  pm.expect([\"MISS\", \"HIT\"]).to.include(pm.response.headers.get('X-Cache'));",
                  "});",
                  "const body = pm.response.json();",
                  "const pet = body.primary ?? body.secondary[0];",
                  "pm.test('the demo user holds a creature', () => pm.expect(pet).to.be.an('object'));",
                  "pm.collectionVariables.set('cache_pet_id', pet.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{demo_credential}}"
