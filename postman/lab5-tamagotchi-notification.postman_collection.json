            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{demo_credential}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "If-Match",
                "value": "{{cache_preferences_etag}}"
              }
            ],
            "url": {
              "raw": "{{notification_base_url}}/v1/users/{{demo_user_id}}/preferences",
