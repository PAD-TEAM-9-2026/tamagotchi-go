    {
      "name": "Fault switch refusals",
      "description": "Change nothing. The switch is only on the service port, needs the admin role and accepts only Tamagotchi's own internal operations.",
      "item": [
        {
          "name": "The Gateway does not route the fault switch",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('404 unknown_route', () => {",
                  "  pm.response.to.have.status(404);",
                  "  pm.expect(pm.response.json().code).to.eql('unknown_route');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_credential}}"
