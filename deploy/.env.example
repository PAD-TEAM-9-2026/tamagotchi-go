# Copy to deploy/.env and fill in. This file holds no working credentials; use distinct values.
# Generate the keys and certificates first (they stay in the git-ignored deploy/secrets/):
#   ./user-management/generate-keys.sh && ./gateway/generate-keys.sh && ./message-broker/generate-identities.sh

# Databases: the shared PostgreSQL (one database per service) and the broker's own.
DATABASE_ADMIN_PASSWORD=
USER_MANAGEMENT_DB_USER=user_management
USER_MANAGEMENT_DB_PASSWORD=
USER_MANAGEMENT_DB_NAME=user_management
TAMAGOTCHI_DB_USER=tamagotchi
TAMAGOTCHI_DB_PASSWORD=
TAMAGOTCHI_DB_NAME=tamagotchi
BATTLE_DB_USER=battle
BATTLE_DB_PASSWORD=
BATTLE_DB_NAME=battle
GUILD_DB_USER=guild
GUILD_DB_PASSWORD=
GUILD_DB_NAME=guild
REGISTRY_DB_USER=registry
REGISTRY_DB_PASSWORD=
REGISTRY_DB_NAME=registry
MAP_DB_USER=map
MAP_DB_PASSWORD=
MAP_DB_NAME=map
MONSTER_RAID_DB_USER=monster_raid
MONSTER_RAID_DB_PASSWORD=
MONSTER_RAID_DB_NAME=monster_raid
NOTIFICATION_DB_USER=notification
NOTIFICATION_DB_PASSWORD=
NOTIFICATION_DB_NAME=notification
BROKER_DB_USER=message_broker
BROKER_DB_PASSWORD=
BROKER_DB_NAME=message_broker

# Key IDs of the generated keys.
GATEWAY_ASSERTION_KEY_ID=gateway-assertion-1
USER_MANAGEMENT_ACCESS_TOKEN_KEY_ID=user-management-access-1
BROKER_CONTEXT_KEY_ID=broker-context-1

# One secret per service that calls other services, sent as x-service-secret metadata on its
# broker token request (users.issue_service_token). Registry and Notification call nothing.
USER_MANAGEMENT_SERVICE_CLIENT_SECRET=
TAMAGOTCHI_SERVICE_CLIENT_SECRET=
BATTLE_SERVICE_CLIENT_SECRET=
GUILD_SERVICE_CLIENT_SECRET=
MAP_SERVICE_CLIENT_SECRET=
MONSTER_RAID_SERVICE_CLIENT_SECRET=

# Page cursor keys: distinct base64 values of at least 32 random bytes (openssl rand -base64 32).
USER_MANAGEMENT_CURSOR_SIGNING_KEY=
BATTLE_CURSOR_SIGNING_KEY=
MAP_CURSOR_SIGNING_KEY=
MONSTER_RAID_CURSOR_SIGNING_KEY=

# Log levels. Restart the service after a change.
GATEWAY_LOG_LEVEL=info
SERVICE_DISCOVERY_LOG_LEVEL=info
USER_MANAGEMENT_LOG_LEVEL=info
BATTLE_LOG_LEVEL=info
TAMAGOTCHI_LOG_LEVEL=info
NOTIFICATION_LOG_LEVEL=info
MAP_LOG_LEVEL=Information
MONSTER_RAID_LOG_LEVEL=Information
BROKER_LOG_LEVEL=INFO

# Service Discovery alerts. Keep the webhook URL private; empty only logs alerts.
ALERT_COOLDOWN_SECONDS=300
DISCORD_WEBHOOK_URL=

# Browser-reachable Guild socket ingress; remote HTTPS clients need wss.
WS_GUILD_PUBLIC_URL=ws://localhost:3004

# Notification push: stub, or firebase with a base64 service account.
NOTIFICATION_PUSH_PROVIDER=stub
FIREBASE_SERVICE_ACCOUNT_BASE64=

# Log volumes: the group the broker exports with, and each image's runtime user (defaults match the images).
LOG_READER_GID=20000
GATEWAY_LOG_UID=1001
DISCOVERY_LOG_UID=1001
BROKER_LOG_UID=10001
USER_MANAGEMENT_LOG_UID=1654
BATTLE_LOG_UID=1654
MAP_LOG_UID=1654
MONSTER_RAID_LOG_UID=1654
GUILD_LOG_UID=1000
REGISTRY_LOG_UID=1000
TAMAGOTCHI_LOG_UID=1000
NOTIFICATION_LOG_UID=1000

# compose.monitoring.yaml only.
GRAFANA_ADMIN_PASSWORD=
GRAFANA_PORT=3030

# compose.source.yaml only: local checkouts to build from (absolute, or relative to deploy/).
MESSAGE_BROKER_SOURCE=
GATEWAY_SOURCE=
SERVICE_DISCOVERY_SOURCE=
USER_MANAGEMENT_SOURCE=
BATTLE_SOURCE=
TAMAGOTCHI_SOURCE=
NOTIFICATION_SOURCE=
GUILD_SOURCE=
REGISTRY_SOURCE=
MAP_SOURCE=
MONSTER_RAID_SOURCE=
